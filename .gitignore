.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# Corpus privado y salidas generadas
corpus/raw/*
!corpus/raw/.gitkeep
corpus/cache/*
!corpus/cache/.gitkeep
corpus/processed/*
!corpus/processed/.gitkeep
corpus/queries/*
!corpus/queries/.gitkeep
outputs/*
!outputs/.gitkeep

# Artefactos de modelos, embeddings e indices
*.faiss
*.index
*.bin
embeddings*.npy
embeddings*.npz
metadata*.jsonl
.cache/huggingface/
hf_cache/
models/
tessdata/
*.traineddata

# Logs, temporales y sistema operativo
*.log
*.tmp
*.temp
*.bak
*.partial
*.incomplete
.~*
.DS_Store
Thumbs.db
ocr_prueba_temporal.*

# IDE y configuracion local
.vscode/
.idea/
*.local
.env
.env.*

# Datos locales sensibles. La publicacion usa ademas escaneo de contenido staged.
.secrets/

